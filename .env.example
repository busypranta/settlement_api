SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Docker/production: set DEBUG=False, use a SECRET_KEY of at least 32 random
# characters, list the public hostname in ALLOWED_HOSTS, and add its HTTPS
# origin to CSRF_TRUSTED_ORIGINS (for example:
# https://sandbox-pg.janatapay.com). Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

PORTAL_ORACLE_DSN=host:port/service_name
PORTAL_ORACLE_USER=portal_schema_user
PORTAL_ORACLE_PASSWORD=portal_schema_password

# Prefix applied to every table created by this project, including Django and
# third-party tables (for example: jp_).
DB_TABLE_PREFIX=settlement_api_

DAYS_ALLOWED_FOR_REPORT=90

SOURCE_SCHEMA=JPAY_RECON

# Set False when an upstream proxy/WAF terminates TLS and forwards plain HTTP
# to this container without X-Forwarded-Proto: https (otherwise Django will
# redirect in a loop). Keep True when the proxy sends that header.
SECURE_SSL_REDIRECT=False
